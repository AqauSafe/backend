# Copy to .env and replace every placeholder. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Local PostgreSQL (peer/socket auth) or Docker Compose PostgreSQL on port 5433.
DATABASE_URL=postgres:///aquasafe
# DATABASE_URL=postgres://aquasafe:aquasafe@localhost:5433/aquasafe

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA_CERTS=
MQTT_USERNAME=aquasafe-backend
MQTT_PASSWORD=replace-with-broker-password
MQTT_TOPIC_PREFIX=aquasafe/v1
MQTT_QOS=1
MQTT_KEEPALIVE=60

# Development-only bridge for the original fish_pond-live.html demo.
SIMULATION_LEGACY_BRIDGE_ENABLED=false
SIMULATION_LEGACY_BRIDGE_POND_ID=
SIMULATION_LEGACY_MQTT_HOST=broker.hivemq.com
SIMULATION_LEGACY_MQTT_PORT=1883
SIMULATION_LEGACY_TOPIC=techsharks-fishpond-7731/readings

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_SECRET_ENCRYPTION_KEY=

# Email alert delivery stays disabled until a real provider is configured.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_BATCH_SIZE=100
DEFAULT_FROM_EMAIL=AquaSafe <alerts@example.com>
